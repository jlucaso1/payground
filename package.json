{
  "name": "payground-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlucaso1/payground.git"
  },
  "homepage": "https://github.com/jlucaso1/payground#readme",
  "bugs": {
    "url": "https://github.com/jlucaso1/payground/issues"
  },
  "workspaces": [
    "packages/*",
    "tools/*",
    "e2e"
  ],
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "bun-plugin-tailwind": "^0.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build": "bun run build:dashboard && bun run build:cli",
    "build:cli": "bun build packages/cli/src/index.ts --target=bun --outfile packages/cli/dist/payground.js --external bun-plugin-tailwind --minify",
    "build:dashboard": "bun packages/dashboard/src/cli-build.ts packages/cli/dist/dashboard",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/dashboard",
    "test": "bun test packages tools",
    "test:e2e": "bun test e2e",
    "spec:sync": "bun tools/spec-sync/src/sync.ts",
    "spec:gen": "bun tools/spec-sync/src/gen.ts",
    "spec:tables": "bun tools/spec-sync/src/tables-cli.ts",
    "start": "bun packages/cli/src/index.ts start"
  }
}
